{$APP_DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }
    request_body {
        max_size 100MB
    }
    reverse_proxy app:5680 {
        transport http {
            response_header_timeout 600s
        }
    }
}
