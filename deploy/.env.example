APP_DOMAIN=studio.example.com
APP_VERSION=local
# If Docker Hub is unreachable, use Docker Official Images hosted by AWS:
# NODE_IMAGE=public.ecr.aws/docker/library/node:22-bookworm-slim
# CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2-alpine
# Initially false. For onboarding, temporarily enable, recreate app, then disable again.
ALLOW_REGISTRATION=false
# Platform admin user IDs from the database; comma-separate multiple IDs.
PLATFORM_ADMIN_USER_IDS=
AI_TASK_CONCURRENCY=4
# Optional per-workspace AI burst limiter; 0 means no image/video burst cap.
AI_GENERATION_RATE_LIMIT=0
AI_DAILY_REQUEST_LIMIT=300
AI_MAX_PENDING_PER_ORG=50
